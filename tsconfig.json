{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOMIterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Alias Configuration - ADDED THIS BLOCK */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"] 
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // CRITICAL FIXES FOR ROOT-LEVEL SOURCE FILES (Confirmed in last step)
    "rootDir": "."  
  },
  "include": ["**/*.ts", "**/*.tsx"]
}